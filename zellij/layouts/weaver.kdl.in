// The weaver session's layout (`weaver` starts it): home first, thread tabs
// after it (`weaver new` adds them, each with the thread sidebar), and one
// status line in place of the tab bar: the current tab's name (a thread's is
// "<num> <name> · <repo>/<branch>"), weaver's counts and the mode.
layout {
    default_tab_template {
        children

        pane size=1 borderless=true {
            plugin location="file:$HOME/.config/zellij/plugins/zjstatus.wasm" {
                format_left  " {tabs}"
                format_right "{command_weaver}{mode} "
                format_space ""
                pane_frames false

                command_weaver_command    "weaver status --zjstatus"
                command_weaver_format     "{stdout}"
                command_weaver_interval   "2"
                command_weaver_rendermode "dynamic"

                mode_locked "#[fg=${PALETTE_GRAY_DIM}][LOCK]"
                mode_normal "#[fg=${PALETTE_GRAY_DIM}][NRM]"
                mode_tab    "#[fg=${PALETTE_WHITE},bold][TAB]"
                mode_pane   "#[fg=${PALETTE_WHITE},bold][PANE]"
                mode_tmux   "#[fg=${PALETTE_GRAY}][TMUX]"
                mode_resize "#[fg=${PALETTE_WHITE},bold][SIZE]"
                mode_move   "#[fg=${PALETTE_WHITE},bold][MOVE]"

                // Only the current tab: the sidebar shows every thread.
                tab_normal               ""
                tab_normal_fullscreen    ""
                tab_normal_sync          ""
                tab_normal_bell          ""
                tab_normal_flashing_bell ""
                tab_active               "#[fg=${PALETTE_WHITE},bold]{name}"
                tab_active_fullscreen    "#[fg=${PALETTE_WHITE},bold]{name} #[fg=${PALETTE_GRAY_DIM}]full"
            }
        }
    }
    tab name="home" focus=true {
        pane name="home" command="weaver" {
            args "home"
        }
    }
}
