layout {
    default_tab_template {
        children

        pane size=1 borderless=true {
            plugin location="file:$HOME/.config/zellij/plugins/zjstatus.wasm" {
                format_left  " {tabs}"
                format_right "{command_weaver}{mode} "
                format_space ""
                pane_frames false

                // weaver: agents that need you (red), finished and unseen
                // (green), working (grey), from `weaver status --zjstatus`.
                command_weaver_command    "weaver status --zjstatus"
                command_weaver_format     "{stdout}"
                command_weaver_interval   "2"
                command_weaver_rendermode "dynamic"

                mode_locked "#[fg=${PALETTE_GRAY_DIM}][LOCK]"
                mode_normal "#[fg=${PALETTE_GRAY_DIM}][NRM]"
                mode_tab    "#[fg=${PALETTE_WHITE},bold][TAB]"
                mode_pane   "#[fg=${PALETTE_WHITE},bold][PANE]"
                mode_tmux   "#[fg=${PALETTE_GRAY}][TMUX]"
                mode_resize "#[fg=${PALETTE_WHITE},bold][SIZE]"
                mode_move   "#[fg=${PALETTE_WHITE},bold][MOVE]"

                tab_normal "#[fg=${PALETTE_GRAY_DIM}][{index}] {name} "
                tab_active "#[fg=${PALETTE_BLACK},bg=${PALETTE_WHITE},bold][{index}] {name} "
                // A tab whose agent rang the bell (needs you, or finished)
                // stands out in ink, marked *, until you look at it (● is the
                // counts' working).
                tab_normal_bell          "#[fg=${PALETTE_WHITE},bold][{index}] {name}{bell_indicator} "
                tab_normal_flashing_bell "#[fg=${PALETTE_WHITE},bold][{index}] {name}{bell_indicator} "
                tab_bell_indicator          " *"
                tab_flashing_bell_indicator "  "
            }
        }
    }
    tab name="main" focus=true {
      pane focus=true cwd="~"
    }
    tab name="nvim" focus=false {
      pane command="nvim" cwd="~/me/code/"
    }
}
