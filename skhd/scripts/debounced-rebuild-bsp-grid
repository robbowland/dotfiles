#!/bin/sh

set -eu

space="${1:-}"

safe_space="$(
  printf '%s\n' "${space:-current}" |
    tr -c '[:alnum:]_.-' '_'
)"
lock_dir="${TMPDIR:-/tmp}/yabai-bsp-grid-${USER:-user}-${safe_space}.lock"
request_file="${TMPDIR:-/tmp}/yabai-bsp-grid-${USER:-user}-${safe_space}.request"

printf '%s:%s\n' "$$" "$(date +%s)" > "$request_file"

if ! mkdir "$lock_dir" 2>/dev/null; then
  exit 0
fi

cleanup() {
  rm -f "$request_file" 2>/dev/null || true
  rmdir "$lock_dir" 2>/dev/null || true
}

trap cleanup EXIT INT TERM

while :; do
  observed="$(cat "$request_file" 2>/dev/null || true)"
  sleep "${YABAI_BSP_GRID_DEBOUNCE:-0.12}"
  current="$(cat "$request_file" 2>/dev/null || true)"

  if [ "$observed" = "$current" ]; then
    rm -f "$request_file"

    if [ -n "$space" ]; then
      space_json="$(yabai -m query --spaces --space "$space")"
      windows_json="$(yabai -m query --windows --space "$space")"
    else
      space_json="$(yabai -m query --spaces --space)"
      windows_json="$(yabai -m query --windows --space)"
    fi

    layout="$(printf '%s\n' "$space_json" | jq -r '.type')"
    stacked_windows="$(
      printf '%s\n' "$windows_json" |
        jq -r '
          map(select((.["is-minimized"] | not) and (.["is-hidden"] | not))) |
          map(select(.["is-floating"] | not)) |
          map(select(.["can-move"] and .["can-resize"] and .["has-ax-reference"])) |
          map(select(.role == "AXWindow" and .subrole == "AXStandardWindow")) |
          map(select(.["stack-index"] > 0)) |
          length
        '
    )"

    if [ "$layout" != "stack" ] && [ "$stacked_windows" -eq 0 ]; then
      "$HOME/.config/skhd/scripts/rebuild-bsp-grid" "$space"
    fi

    [ -f "$request_file" ] || break
  fi
done
