#!/bin/sh

set -eu

target="${1:?usage: send-window-to-space <space-selector>}"

space_index_for_label() {
  yabai -m query --spaces | jq -er --arg label "$1" '.[] | select(.label == $label) | .index'
}

case "$target" in
  prev)
    if ! yabai -m window --space prev --focus 2>/dev/null; then
      yabai -m window --space last --focus
    fi
    ;;
  next)
    if ! yabai -m window --space next --focus 2>/dev/null; then
      yabai -m window --space first --focus
    fi
    ;;
  notes|web|terminal|code|other)
    target_index="$(space_index_for_label "$target")"
    yabai -m window --space "$target_index" --focus
    ;;
  *)
    yabai -m window --space "$target" --focus
    ;;
esac

sketchybar --trigger windows_on_spaces
