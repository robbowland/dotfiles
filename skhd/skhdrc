# Yabai

# -- Fixed spaces
alt - a : yabai -m space --focus notes
alt - s : yabai -m space --focus web
alt - d : yabai -m space --focus terminal
alt - f : yabai -m space --focus code
alt - g : yabai -m space --focus other

# -- Space cycling
alt - q : yabai -m space --focus prev || yabai -m space --focus last
alt - e : yabai -m space --focus next || yabai -m space --focus first

# -- Window focus
cmd + shift - h : "$HOME/.config/skhd/scripts/focus-window" west
cmd + shift - j : "$HOME/.config/skhd/scripts/focus-window" south
cmd + shift - k : "$HOME/.config/skhd/scripts/focus-window" north
cmd + shift - l : "$HOME/.config/skhd/scripts/focus-window" east

# -- Move window in tree
cmd + alt - h : yabai -m window --warp west
cmd + alt - j : yabai -m window --warp south
cmd + alt - k : yabai -m window --warp north
cmd + alt - l : yabai -m window --warp east

# -- Move window to fixed spaces
shift + alt - a : "$HOME/.config/skhd/scripts/send-window-to-space" notes
shift + alt - s : "$HOME/.config/skhd/scripts/send-window-to-space" web
shift + alt - d : "$HOME/.config/skhd/scripts/send-window-to-space" terminal
shift + alt - f : "$HOME/.config/skhd/scripts/send-window-to-space" code
shift + alt - g : "$HOME/.config/skhd/scripts/send-window-to-space" other

# -- Move window while cycling spaces
shift + alt - q : "$HOME/.config/skhd/scripts/send-window-to-space" prev
shift + alt - e : "$HOME/.config/skhd/scripts/send-window-to-space" next
shift + alt - m : "$HOME/.config/skhd/scripts/send-window-to-space" last

# -- Float / unfloat window
alt - z : \
    yabai -m window --toggle float; \
    sketchybar --trigger window_focus

# -- Resize windows
lctrl + alt - h : yabai -m window --resize left:-50:0; \
                  yabai -m window --resize right:-50:0
lctrl + alt - j : yabai -m window --resize bottom:0:50; \
                  yabai -m window --resize top:0:50
lctrl + alt - k : yabai -m window --resize top:0:-50; \
                  yabai -m window --resize bottom:0:-50
lctrl + alt - l : yabai -m window --resize right:50:0; \
                  yabai -m window --resize left:50:0

# -- Balance current space
lctrl + alt - e : yabai -m space --balance

# -- Layout / stack mode
cmd + shift - s : "$HOME/.config/skhd/scripts/toggle-stack-layout"

# -- Enable / Disable gaps in current workspace
lctrl + alt - g : yabai -m space --toggle padding; yabai -m space --toggle gap

# -- Rotate windows clockwise and anticlockwise
alt - r         : yabai -m space --rotate 270
shift + alt - r : yabai -m space --rotate 90

# -- Rotate on X and Y Axis
shift + alt - x : yabai -m space --mirror x-axis
shift + alt - y : yabai -m space --mirror y-axis

# -- Set insertion point for focused container
shift + lctrl + alt - h : yabai -m window --insert west
shift + lctrl + alt - j : yabai -m window --insert south
shift + lctrl + alt - k : yabai -m window --insert north
shift + lctrl + alt - l : yabai -m window --insert east
