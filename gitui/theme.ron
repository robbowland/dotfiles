(
  // core
  syntax:                   Some("GitHubDark"),
  selected_tab:             Some("Reset"),

  // command bar
  cmdbar_bg:                Some("#000000"),
  cmdbar_extra_lines_bg:    Some("#000000"),
  command_fg:               Some("#e6edf3"),
  disabled_fg:              Some("#b7c2cc"),

  // selection (microcontrast + readable bold)
  selection_bg:             Some("#0c0c0c"),
  selection_fg:             Some("#000000"),
  selection_bold:           Some(true),
  selection_italic:         Some(false),
  use_selection_fg:         Some(false),

  // file tree
  file_tree_path_unselected_fg:      Some("#3e7cc4"),
  file_tree_path_selected_fg:        Some("#79c0ff"),
  file_tree_path_icon_unselected_fg: Some("#3e7cc4"),
  file_tree_path_icon_selected_fg:   Some("#79c0ff"),

  // diff
  diff_line_add:             Some("#3fb950"),
  diff_line_delete:          Some("#f85149"),
  diff_file_added:           Some("#3fb950"),
  diff_file_removed:         Some("#f85149"),
  diff_file_moved:           Some("#bc8cff"),
  diff_file_modified:        Some("#d29922"),

  // status (dimmed for unselected)
  status_new_unselected_fg:        Some("#2f9142"),
  status_modified_unselected_fg:   Some("#9d731a"),
  status_deleted_unselected_fg:    Some("#bd3d38"),
  status_renamed_unselected_fg:    Some("#946ccc"),
  status_conflicted_unselected_fg: Some("#aa541e"),
  status_typechange_unselected_fg: Some("#ad4d85"),

  // commit list
  commit_hash:               Some("#bc8cff"),
  commit_time:               Some("#79c0ff"),
  commit_author:             Some("#3fb950"),

  // branches / tags
  branch_fg:                 Some("#d29922"),
  tag_fg:                    Some("#bc8cff"),

  // misc
  danger_fg:                 Some("#f85149"),
  push_gauge_bg:             Some("#58a6ff"),
  push_gauge_fg:             Some("Reset"),
)
