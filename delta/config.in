[delta]
syntax-theme = "GitHubDark"
features = "github-dark"
navigate = true
line-numbers = true
pager = "diffnav"
tabs = 2

# --- file header
file-style = "${PALETTE_WHITE}" bold
file-decoration-style = none

# --- line numbers (neutral; brighten +/- counters only)
line-numbers-left-format = "{nm:>4} "
line-numbers-right-format = "│ {np:>4} "
line-numbers-left-style = "${PALETTE_GRAY}"
line-numbers-right-style = "${PALETTE_GRAY}"
line-numbers-zero-style = "${PALETTE_GRAY}"
line-numbers-plus-style = "${PALETTE_WHITE_BRIGHT}"
line-numbers-minus-style = "${PALETTE_WHITE_BRIGHT}"

# --- wrap symbols (invisible)
wrap-left-symbol = " "
wrap-right-symbol = " "
wrap-right-prefix-symbol = " "

# --- hunk header
hunk-label = "  󰡏 "
hunk-header-style = "syntax bold"
hunk-header-file-style = "${PALETTE_GRAY}"
hunk-header-line-number-style = "${PALETTE_GRAY}"
file-decoration-style = none
hunk-header-decoration-style = none
commit-decoration-style = none

[delta "github-dark"]
minus-style = "syntax #3b1f25"
minus-emph-style = "syntax #9b3836"
plus-style = "syntax #1f3a30"
plus-emph-style = "syntax #2c7a41"

# Unchanged context (keep syntax)
zero-style = "syntax"
