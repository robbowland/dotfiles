[delta]
syntax-theme = "Micrographics"
features = "micrographics"
navigate = true
line-numbers = true
pager = "diffnav"
tabs = 2

# --- file header
file-style = "#ffffff" bold
file-decoration-style = none

# --- line numbers (neutral; brighten +/- counters only)
line-numbers-left-format = "{nm:>4} "
line-numbers-right-format = "│ {np:>4} "
line-numbers-left-style = "#999999"
line-numbers-right-style = "#999999"
line-numbers-zero-style = "#999999"
line-numbers-plus-style = "#ffffff"
line-numbers-minus-style = "#ffffff"

# --- wrap symbols (invisible)
wrap-left-symbol = " "
wrap-right-symbol = " "
wrap-right-prefix-symbol = " "

# --- hunk header
hunk-label = "  󰡏 "
hunk-header-style = "syntax bold"
hunk-header-file-style = "#999999"
hunk-header-line-number-style = "#999999"
file-decoration-style = none
hunk-header-decoration-style = none
commit-decoration-style = none

[delta "github-dark"]
minus-style = "syntax #3b1f25"
minus-emph-style = "syntax #9b3836"
plus-style = "syntax #1f3a30"
plus-emph-style = "syntax #2c7a41"

# Unchanged context (keep syntax)
zero-style = "syntax"

# Default Micrographics profile; override DELTA_FEATURES to select another feature.
[delta "micrographics"]
syntax-theme = "Micrographics"
file-style = "#ffffff" bold
line-numbers-left-style = "#616161"
line-numbers-right-style = "#616161"
line-numbers-zero-style = "#616161"
line-numbers-plus-style = "#ffffff"
line-numbers-minus-style = "#ff3b2f"
hunk-header-file-style = "#999999"
hunk-header-line-number-style = "#999999"
minus-style = "syntax #ff3b2f"
minus-emph-style = "syntax #ff3b2f" bold
plus-style = "syntax #ffffff"
plus-emph-style = "syntax #ffffff" bold
zero-style = "syntax"
