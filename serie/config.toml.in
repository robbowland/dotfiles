[keybind]
user_command_view_toggle_1 = ["d"]

[core.user_command]
commands_1 = { name = "delta diff", commands = ["sh", "-c", "git --no-pager diff --color=always {{first_parent_hash}} {{target_hash}} | delta --paging=never"] }

[ui.detail]
height = 12

[ui.user_command]
height = 10

[graph.color]
branches = [
  "${PALETTE_WHITE}",
  "${PALETTE_GRAY}",
  "${PALETTE_GRAY_DIM}",
  "${PALETTE_WHITE}",
  "${PALETTE_GRAY}",
  "${PALETTE_GRAY_DIM}",
]
edge = "${PALETTE_GRAY_DIM}"
background = "${PALETTE_BLACK}"

[color]
fg = "${PALETTE_WHITE}"
bg = "${PALETTE_BLACK}"
list_selected_fg = "${PALETTE_BLACK}"
list_selected_bg = "${PALETTE_WHITE}"
list_selected_bold = true
list_selected_italic = false
ref_selected_fg = "${PALETTE_BLACK}"
ref_selected_bg = "${PALETTE_WHITE}"
ref_selected_bold = true
ref_selected_italic = false
list_subject_fg = "${PALETTE_WHITE}"
list_name_fg = "${PALETTE_WHITE}"
list_hash_fg = "${PALETTE_GRAY}"
list_date_fg = "${PALETTE_GRAY_DIM}"
list_match_fg = "${PALETTE_BLACK}"
list_match_bg = "${PALETTE_WHITE}"
list_ref_paren_fg = "${PALETTE_GRAY_DIM}"
list_ref_branch_fg = "${PALETTE_WHITE}"
list_ref_remote_branch_fg = "${PALETTE_GRAY}"
list_ref_tag_fg = "${PALETTE_WHITE}"
list_ref_stash_fg = "${PALETTE_GRAY}"
list_head_fg = "${PALETTE_WHITE}"
detail_email_fg = "${PALETTE_GRAY}"
detail_ref_branch_fg = "${PALETTE_WHITE}"
detail_ref_remote_branch_fg = "${PALETTE_GRAY}"
detail_ref_tag_fg = "${PALETTE_WHITE}"
detail_file_change_add_fg = "${PALETTE_WHITE}"
detail_file_change_modify_fg = "${PALETTE_GRAY}"
detail_file_change_delete_fg = "${PALETTE_RED}"
detail_file_change_move_fg = "${PALETTE_GRAY}"
status_input_fg = "${PALETTE_WHITE}"
status_input_transient_fg = "${PALETTE_GRAY_DIM}"
status_info_fg = "${PALETTE_GRAY}"
status_success_fg = "${PALETTE_WHITE}"
status_warn_fg = "${PALETTE_RED}"
status_error_fg = "${PALETTE_RED}"
virtual_cursor_fg = "${PALETTE_WHITE}"
help_block_title_fg = "${PALETTE_WHITE}"
help_key_fg = "${PALETTE_GRAY}"
divider_fg = "${PALETTE_GRAY_DIM}"
