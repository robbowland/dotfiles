[mgr]
hovered         = { bg = "${PALETTE_SURFACE_0}", bold = true }
preview_hovered = { bg = "${PALETTE_SURFACE_0}", bold = true }
cwd             = { fg = "${PALETTE_BLUE}" }
syntect_theme   = "~/.config/yazi/preview/GitHubDark.tmTheme"

[filetype]
rules = [
  { url = "*/",        fg = "${PALETTE_BLUE_DIM}" },
  { url = "*",         is = "link",   fg = "${PALETTE_MAGENTA}" },
  { url = "*",         is = "orphan", fg = "${PALETTE_RED}" },
  { url = "*",         is = "exec",   fg = "${PALETTE_GREEN}" },
  { url = "*.zip",     fg = "${PALETTE_ORANGE}" },
  { url = "*.tar",     fg = "${PALETTE_ORANGE}" },
  { url = "*.gz",      fg = "${PALETTE_ORANGE}" },
  { url = "*.7z",      fg = "${PALETTE_ORANGE}" },
  { mime = "image/*",  fg = "${PALETTE_YELLOW}" },
  { mime = "video/*",  fg = "${PALETTE_MAGENTA}" },
  { mime = "audio/*",  fg = "${PALETTE_MAGENTA}" },
  { url = "*.dmg",     fg = "${PALETTE_YELLOW}" },
  { url = "*.iso",     fg = "${PALETTE_YELLOW}" },
  { url = ".*",        fg = "${PALETTE_GRAY_DIM}" },
]

[mode]
normal_main = { bg = "${PALETTE_BLACK}" }
normal_alt  = { bg = "${PALETTE_BLACK}" }

[status]
overall         = { fg = "${PALETTE_GRAY_DIM}", bg = "${PALETTE_BLACK}" }
sep_left        = { open = "", close = "", fg = "${PALETTE_GRAY_DIM}", bg = "${PALETTE_BLACK}" }
sep_right       = { open = "", close = "", fg = "${PALETTE_GRAY_DIM}", bg = "${PALETTE_BLACK}" }
perm_sep        = { fg = "${PALETTE_GRAY_DIM}", bg = "${PALETTE_BLACK}" }
perm_type       = { fg = "${PALETTE_BLUE}",   bg = "${PALETTE_BLACK}" }
perm_read       = { fg = "${PALETTE_YELLOW}", bg = "${PALETTE_BLACK}" }
perm_write      = { fg = "${PALETTE_RED}",    bg = "${PALETTE_BLACK}" }
perm_exec       = { fg = "${PALETTE_GREEN}",  bg = "${PALETTE_BLACK}" }
progress_label  = { fg = "${PALETTE_GRAY_DIM}", bg = "${PALETTE_BLACK}" }
progress_normal = { fg = "${PALETTE_GRAY_DIM}", bg = "${PALETTE_BLACK}" }
progress_error  = { fg = "${PALETTE_GRAY_DIM}", bg = "${PALETTE_BLACK}" }
