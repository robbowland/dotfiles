# Default Micrographics palette. `micrographics-terminal` remains available
# as a compatibility launcher for an isolated themed window.
background = #000000
foreground = #ffffff
cursor-color = #ffffff
cursor-text = #000000
selection-background = #ffffff
selection-foreground = #000000

# ANSI roles: additions/success use green, danger uses red, and other distinctions use ink weight.
palette = 0=#000000
palette = 1=#ff3b2f
palette = 2=#39d97a
palette = 3=#ff3b2f
palette = 4=#999999
palette = 5=#999999
palette = 6=#999999
palette = 7=#ffffff
palette = 8=#404040
palette = 9=#ff3b2f
palette = 10=#39d97a
palette = 11=#ff3b2f
palette = 12=#ffffff
palette = 13=#ffffff
palette = 14=#ffffff
palette = 15=#ffffff
