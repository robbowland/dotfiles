theme = Micrographics
background = 000000
foreground = ffffff

macos-titlebar-style = hidden

font-size = 16
font-thicken=true
font-family="JetBrainsMono Nerd Font Mono"

macos-option-as-alt=true

keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

window-padding-x = 17
window-padding-x = 16

keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position=center
quick-terminal-screen=mouse
quick-terminal-autohide=true
quick-terminal-animation-duration=0.05

window-vsync=true

shell-integration=fish

# Ghostty's own splits
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
# Cmd+Alt+D / Cmd+Alt+Shift+D go to the terminal program, which weaver's tmux
# turns into pane splits. Not as kitty-protocol keys (csi:100;9u): tmux reads
# those as Alt+d, Option+d's own. Outside tmux they do nothing.
keybind = super+alt+d=csi:100;9~
keybind = super+alt+shift+d=csi:100;10~
