palette = "micrographics"

format = """
$directory\
$git_branch\
$git_state\
$git_status\
$python\
$cmd_duration\
$line_break\
$character"""

[palettes.micrographics]
paper = "${PALETTE_BLACK}"
ink = "${PALETTE_WHITE}"
metadata = "${PALETTE_GRAY}"
faint = "${PALETTE_GRAY_DIM}"
danger = "${PALETTE_RED}"
selection = "${PALETTE_SURFACE_0}"

[directory]
format = "[$path]($style) "
style = "metadata"
truncation_length = 2
truncate_to_repo = false

[git_branch]
format = "[$branch]($style) "
style = "faint"

[git_status]
format = "[$all_status$ahead_behind]($style) "
style = "faint"
conflicted = "[!](bold danger)"
untracked = ""
modified = ""
staged = ""
renamed = ""
deleted = "[-](danger)"
stashed = ""
ahead = "[^](faint)"
behind = "[v](faint)"
diverged = "[!^v](danger)"
up_to_date = ""

[git_state]
format = "[$state( $progress_current/$progress_total)]($style) "
style = "metadata"

[cmd_duration]
min_time = 3000
format = "[$duration]($style) "
style = "faint"

[python]
format = "[$virtualenv]($style) "
style = "faint"

[character]
success_symbol = "[>](bold ink)"
error_symbol = "[!](bold danger)"
vimcmd_symbol = "[N](metadata)"
vimcmd_replace_symbol = "[R](danger)"
vimcmd_replace_one_symbol = "[R1](danger)"
vimcmd_visual_symbol = "[V](metadata)"
